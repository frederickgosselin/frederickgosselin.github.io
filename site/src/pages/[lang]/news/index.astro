---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { LANGS, T, fmtDate, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = T[lang];

const all = (await getCollection('news', (e) => e.id.startsWith(lang + '/'))).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = { format: (d: Date) => fmtDate(lang, d) };
const slugOf = (id: string) => id.split('/').slice(1).join('/');
---

<Base lang={lang} title={t.news} current="news" altUrl={`/${lang === 'en' ? 'fr' : 'en'}/news/`}>
  <h1>{t.news}</h1>
  <div class="bar short"><i></i><i></i><i></i><i></i></div>
  <ul class="news-list">
    {all.map((e) => (
      <li>
        <time datetime={e.data.date.toISOString().slice(0, 10)}>{fmt.format(e.data.date)}</time>
        <a class="title" href={`/${lang}/news/${slugOf(e.id)}/`}>{e.data.title}</a>
      </li>
    ))}
  </ul>
</Base>
