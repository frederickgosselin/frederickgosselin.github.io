---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CoverGallery from '../../components/CoverGallery.astro';
import { pageTranslation, type Lang } from '../../i18n';

export async function getStaticPaths() {
  const all = await getCollection('pages');
  return all.map((entry) => {
    const [lang, ...rest] = entry.id.split('/');
    return { params: { lang, page: rest.join('/') }, props: { entry } };
  });
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.page as string;
const { entry } = Astro.props;
const { Content } = await render(entry);
const other = lang === 'en' ? 'fr' : 'en';
const tr = pageTranslation(lang, slug);
---

<Base lang={lang} title={entry.data.title} current={slug} altUrl={tr ? `/${other}/${tr}/` : undefined}>
  <h1>{entry.data.title}</h1>
  <div class="bar short"><i></i><i></i><i></i><i></i></div>
  {entry.data.covers.length > 0 && (
    <CoverGallery
      covers={entry.data.covers}
      closeLabel={lang === 'fr' ? 'Fermer' : 'Close'}
      prevLabel={lang === 'fr' ? 'Précédente' : 'Previous'}
      nextLabel={lang === 'fr' ? 'Suivante' : 'Next'}
    />
  )}
  <div class="prose"><Content /></div>
</Base>
