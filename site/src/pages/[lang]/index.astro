---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import { LANGS, LINKS, T, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = T[lang];

const latest = (await getCollection('news', (e) => e.id.startsWith(lang + '/')))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
---

<Base lang={lang} current="home" wide>
  <section class="hero">
    <div>
      <h1>{t.siteName}</h1>
      <p class="role">{t.role}</p>
      <div class="bar short"><i></i><i></i><i></i><i></i></div>
      <p class="lab">{t.lab}</p>
      <p class="profiles">
        <a href={LINKS.lm2} rel="noopener">{t.labSite}</a> ·
        <a href={LINKS.lm2Linkedin} rel="noopener">{t.labLinkedin}</a> ·
        <a href={LINKS.linkedin} rel="noopener">{t.myLinkedin}</a>
      </p>
    </div>
    <a class="lab-logo" href={LINKS.lm2} rel="noopener" aria-label={t.labSite}>
      <img class="on-light" src={`/logos/lm2-${lang}.png`} alt={t.lab} width="480" height="318" />
    </a>
  </section>

  <section style="max-width: 52rem">
    <h2>{t.latest}</h2>
    {latest.map((e) => <NewsCard entry={e} lang={lang} />)}
    <p style="margin-top: 1.25rem"><a href={`/${lang}/news/`}>{t.allNews} →</a></p>
  </section>
</Base>
