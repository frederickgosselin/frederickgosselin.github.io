---
// Root: send visitors to their language. Falls back to English without JavaScript.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Frédérick P. Gosselin</title>
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="/en/" />
    <script is:inline>
      var l = (navigator.language || 'en').slice(0, 2) === 'fr' ? 'fr' : 'en';
      location.replace('/' + l + '/');
    </script>
  </head>
  <body><a href="/en/">English</a> · <a href="/fr/">Français</a></body>
</html>
